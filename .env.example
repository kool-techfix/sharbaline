# Copy to .env for local development. Never commit .env.
# Values here are for a LOCAL dev database only; production values live on the server.

# Runtime connection: restricted role (no DDL, INSERT/SELECT only on append-only tables).
DATABASE_URL=postgresql://hms_app:dev-app-password@localhost:54329/hms
# Migrations and Prisma CLI: schema owner role.
MIGRATE_DATABASE_URL=postgresql://hms_owner:dev-owner-password@localhost:54329/hms

# Superuser password for the local embedded cluster started by `pnpm db:start` (dev only).
DEV_DB_SUPERUSER_PASSWORD=dev-superuser-password

# Public origin of the app, used for Origin checks and cookies.
APP_ORIGIN=http://localhost:3000
# Shown in the UI header.
HOSPITAL_NAME=Demo Hospital

# Next.js telemetry calls the internet; keep it off.
NEXT_TELEMETRY_DISABLED=1

# Seeding refuses to run unless this is "true" (and never in production).
ALLOW_SEED=true

# Stop the Prisma CLI checking the internet for updates.
CHECKPOINT_DISABLE=1

# Shows /dev/components (shared component gallery, no data). Leave unset in production.
HMS_COMPONENT_GALLERY=true

# ── Sign-in (M1) ──
# Generate each with: openssl rand -base64 32   (BACK THESE UP separately from database backups;
# losing MFA_ENCRYPTION_KEY forces everyone to re-enrol, losing AUTH_HMAC_KEY voids recovery codes.)
AUTH_HMAC_KEY=
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_VERSION=1
# Shown in authenticator apps; defaults to "HMS · <HOSPITAL_NAME>".
# TOTP_ISSUER=
# Only "true" when the app port is reachable solely through the reverse proxy.
TRUST_PROXY_HEADERS=false
# Something on the internet the server can reach when the internet is up (required in production).
# INTERNET_PROBE_URL=https://example.org/
# Dev seed users' password (must pass the policy).
SEED_DEFAULT_PASSWORD=
