// HMS database schema. Conventions: docs/architecture.md §2.1. ORM rules: decisions D-001.
//
// Prisma does not model triggers, CHECK constraints, standalone sequences or grants.
// Those live as hand-written SQL in each migration.sql (listed in its header comment),
// with the reverse in down.sql. Columns that a trigger fills in are declared optional
// here and made mandatory with a CHECK constraint, so the Prisma client does not require
// callers to supply them and Prisma's drift detection stays quiet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Staff roles. Must match ROLES in src/server/permissions/roles.ts (checked by a unit test).
enum Role {
  front_desk
  nurse
  doctor
  lab
  pharmacist
  admin
}

enum AuditOutcome {
  success
  failure
  denied
  error
}

/// Append-only (trigger + grants). Every patient-record read/write and every security
/// event lands here. Never store patient data or secrets in any column, metadata included.
/// seq, prev_hash and hash are set by the audit_log_chain trigger; client values are ignored.
model AuditLog {
  id                String       @id @db.Uuid
  seq               BigInt?      @unique
  occurredAt        DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId       String?      @map("actor_user_id") @db.Uuid
  actorRole         Role?        @map("actor_role")
  sessionId         String?      @map("session_id") @db.Uuid
  deviceId          String?      @map("device_id") @db.Uuid
  ip                String?      @db.Inet
  action            String
  resourceType      String?      @map("resource_type")
  resourceId        String?      @map("resource_id")
  patientId         String?      @map("patient_id") @db.Uuid
  outcome           AuditOutcome
  reasonCode        String?      @map("reason_code")
  requestId         String       @map("request_id")
  metadata          Json         @default("{}")
  prevHash          Bytes?       @map("prev_hash")
  hash              Bytes?
  /// Set when the action ran under break-glass (D-028). In the hash only when set (D-035).
  breakGlassEventId String?      @map("break_glass_event_id") @db.Uuid

  breakGlassEvent BreakGlassEvent? @relation(fields: [breakGlassEventId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([patientId, occurredAt])
  @@index([action, occurredAt])
  @@index([breakGlassEventId])
  @@map("audit_log")
}

// ───────────────────────────── Authentication (M1) ─────────────────────────────

enum SessionStage {
  password_change_required
  mfa_enrollment_required
  mfa_pending
  active
}

enum MfaStatus {
  pending
  active
  revoked
}

/// Staff account. staff_id/email are stored trimmed + lower-case (CHECK constraints).
model User {
  id                 String    @id @db.Uuid
  staffId            String    @unique @map("staff_id")
  email              String?   @unique
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  disabledAt         DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles         UserRole[]
  mfaSecrets    MfaSecret[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]

  @@map("user")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String?  @map("granted_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@map("user_role")
}

/// TOTP secret, AES-256-GCM encrypted (key from MFA_ENCRYPTION_KEY, AAD = user id).
/// At most one active row per user (partial unique index in SQL).
model MfaSecret {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  status           MfaStatus
  secretCiphertext Bytes     @map("secret_ciphertext")
  secretIv         Bytes     @map("secret_iv")
  keyVersion       Int       @map("key_version")
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes RecoveryCode[]

  @@index([userId])
  @@map("mfa_secret")
}

/// One-time recovery code, stored as HMAC-SHA256 (high-entropy codes; Argon2 not needed).
model RecoveryCode {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  mfaSecretId String    @map("mfa_secret_id") @db.Uuid
  codeHash    Bytes     @unique @map("code_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  mfaSecret MfaSecret @relation(fields: [mfaSecretId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("recovery_code")
}

/// Server-side session. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id             String       @id @db.Uuid
  tokenHash      Bytes        @unique @map("token_hash")
  userId         String       @map("user_id") @db.Uuid
  deviceId       String?      @map("device_id") @db.Uuid
  activeRole     Role         @map("active_role")
  stage          SessionStage
  /// Expiry of a non-active stage (e.g. 5 minutes to enter the MFA code).
  stageExpiresAt DateTime?    @map("stage_expires_at") @db.Timestamptz(6)
  mfaVerifiedAt  DateTime?    @map("mfa_verified_at") @db.Timestamptz(6)
  ip             String?      @db.Inet
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Last USER-initiated activity (input, actions). Background polling never updates it.
  lastActivityAt DateTime     @map("last_activity_at") @db.Timestamptz(6)
  lastSeenAt     DateTime     @map("last_seen_at") @db.Timestamptz(6)
  lockedAt       DateTime?    @map("locked_at") @db.Timestamptz(6)
  unlockFailures Int          @default(0) @map("unlock_failures")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?      @map("revoked_reason")
  revokedById    String?      @map("revoked_by_id") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
}

/// A browser on a workstation, identified by a long-lived random cookie. Not authentication;
/// used for audit ("from which device") and, later, offline-cache wipe.
model Device {
  id          String   @id @db.Uuid
  label       String?
  userAgent   String?  @map("user_agent")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("device")
}

/// Failed sign-in counter, keyed by an HMAC of the account (or of the typed identifier when no
/// account matches), so unknown identifiers lock exactly like real ones and reveal nothing.
model LoginThrottle {
  keyHash       Bytes     @id @map("key_hash")
  failedCount   Int       @default(0) @map("failed_count")
  firstFailedAt DateTime? @map("first_failed_at") @db.Timestamptz(6)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("login_throttle")
}

// ───────────────────────────── Patient registry (M2) ─────────────────────────────

enum Sex {
  female
  male
}

enum PaperFolderStatus {
  not_digitized
  partial
  digitized
}

enum QueueStatus {
  waiting
  with_nurse
  waiting_doctor
  with_doctor
  done
  left
}

/// Hospital-wide settings, e.g. the patient number prefix (D-003). Changed by admins only.
model HospitalSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("hospital_setting")
}

/// A registered patient. patient_number and patient_seq never change (trigger; D-003).
/// name_search is the normalised full name (lib/domain/names.ts) with a trigram index.
/// Merging is Phase 2; the columns exist now (D-010).
model Patient {
  id                    String            @id @db.Uuid
  patientNumber         String            @unique @map("patient_number")
  patientSeq            BigInt            @unique @map("patient_seq")
  legacyCardNumber      String?           @map("legacy_card_number")
  surname               String
  firstName             String            @map("first_name")
  otherNames            String?           @map("other_names")
  sex                   Sex
  dateOfBirth           DateTime          @map("date_of_birth") @db.Date
  dobIsEstimated        Boolean           @default(false) @map("dob_is_estimated")
  phoneE164             String?           @map("phone_e164")
  address               String?
  nameSearch            String            @map("name_search")
  paperFolderStatus     PaperFolderStatus @default(not_digitized) @map("paper_folder_status")
  priorityFolder        Boolean           @default(false) @map("priority_folder")
  /// Optional photo: not collected in Phase 1 until the client confirms (scope §5 M2).
  photoStorageKey       String?           @map("photo_storage_key")
  consentVersion        String            @map("consent_version")
  consentRecordedAt     DateTime          @map("consent_recorded_at") @db.Timestamptz(6)
  consentRecordedById   String            @map("consent_recorded_by_id") @db.Uuid
  possibleDuplicateOfId String?           @map("possible_duplicate_of_id") @db.Uuid
  mergedIntoId          String?           @map("merged_into_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById           String            @map("created_by_id") @db.Uuid
  updatedAt             DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedById           String            @map("updated_by_id") @db.Uuid

  possibleDuplicateOf Patient?            @relation("PossibleDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: Restrict)
  possibleDuplicates  Patient[]           @relation("PossibleDuplicate")
  mergedInto          Patient?            @relation("MergedInto", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom          Patient[]           @relation("MergedInto")
  nextOfKin           NextOfKin[]
  queueEntries        QueueEntry[]
  duplicateOverrides  DuplicateOverride[] @relation("OverrideNew")
  suspectedIn         DuplicateOverride[] @relation("OverrideSuspected")
  breakGlassEvents    BreakGlassEvent[]
  visits              Visit[]
  vitals              Vitals[]
  allergies           PatientAllergy[]

  @@index([legacyCardNumber])
  @@index([phoneE164])
  @@index([dateOfBirth])
  @@map("patient")
}

model NextOfKin {
  id           String   @id @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  name         String
  relationship String
  phoneE164    String?  @map("phone_e164")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("next_of_kin")
}

/// Append-only: a registration that went ahead despite a possible duplicate (scope §5 M2).
model DuplicateOverride {
  id                 String   @id @db.Uuid
  newPatientId       String   @map("new_patient_id") @db.Uuid
  suspectedPatientId String   @map("suspected_patient_id") @db.Uuid
  /// Duplicate score 0–100 at the time of the override.
  score              Int
  confirmedById      String   @map("confirmed_by_id") @db.Uuid
  confirmedAt        DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)

  newPatient       Patient @relation("OverrideNew", fields: [newPatientId], references: [id], onDelete: Restrict)
  suspectedPatient Patient @relation("OverrideSuspected", fields: [suspectedPatientId], references: [id], onDelete: Restrict)

  @@index([newPatientId])
  @@index([suspectedPatientId])
  @@map("duplicate_override")
}

/// One patient's place in one day's queue (queue_date is the Lagos calendar day).
model QueueEntry {
  id          String      @id @db.Uuid
  patientId   String      @map("patient_id") @db.Uuid
  queueDate   DateTime    @map("queue_date") @db.Date
  position    Int
  status      QueueStatus @default(waiting)
  addedById   String      @map("added_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedById String      @map("updated_by_id") @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visits  Visit[]

  @@unique([queueDate, patientId])
  @@unique([queueDate, position])
  @@map("queue_entry")
}

// ───────────────────────────── Break-glass (D-028, D-035) ─────────────────────────────

enum BreakGlassReason {
  emergency_care
  patient_request
  complaint_investigation
  records_correction
  legal_regulatory
  other
}

enum BreakGlassReviewOutcome {
  appropriate
  inappropriate
  needs_follow_up
}

/// An admin opening one patient's clinical record outside the role matrix, for one session
/// and at most 30 minutes. Append-only, except that ended_at may be set once (trigger).
/// reason_details is free text that may mention the patient: it lives here, never in the
/// audit log or application logs.
model BreakGlassEvent {
  id             String           @id @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  patientId      String           @map("patient_id") @db.Uuid
  reasonCategory BreakGlassReason @map("reason_category")
  reasonDetails  String           @map("reason_details")
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(6)

  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  review       BreakGlassReview?
  auditEntries AuditLog[]

  @@index([userId, sessionId, patientId, expiresAt])
  @@index([patientId, startedAt])
  @@index([startedAt])
  @@map("break_glass_event")
}

/// Append-only. One review per event, by an admin other than the one who broke the glass
/// (service check and trigger).
model BreakGlassReview {
  id         String                  @id @db.Uuid
  eventId    String                  @unique @map("event_id") @db.Uuid
  reviewerId String                  @map("reviewer_id") @db.Uuid
  outcome    BreakGlassReviewOutcome
  comment    String?
  reviewedAt DateTime                @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  event BreakGlassEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("break_glass_review")
}

// ───────────────────────────── Consultation (M3; D-037) ─────────────────────────────

enum VisitType {
  outpatient
  follow_up
  emergency
}

enum VisitStatus {
  open
  closed
}

/// One attendance. Opened by a nurse or doctor (linked to today's queue entry when there is
/// one), closed by the doctor. At most one open visit per patient (partial unique index).
/// Never deleted; only status, the attending doctor and the close fields change.
model Visit {
  id                String      @id @db.Uuid
  patientId         String      @map("patient_id") @db.Uuid
  queueEntryId      String?     @map("queue_entry_id") @db.Uuid
  visitType         VisitType   @map("visit_type")
  status            VisitStatus @default(open)
  attendingDoctorId String?     @map("attending_doctor_id") @db.Uuid
  openedAt          DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  openedById        String      @map("opened_by_id") @db.Uuid
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(6)
  closedById        String?     @map("closed_by_id") @db.Uuid

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry?        @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  vitals       Vitals[]
  noteVersions VisitNoteVersion[]
  noteDrafts   NoteDraft[]

  @@index([patientId, openedAt])
  @@index([queueEntryId])
  @@map("visit")
}

/// Append-only (D-007). A correction is a new row with supersedes_id and a reason; with no
/// measurements it strikes the original out ("entered in error"). Each row is corrected once.
/// Ranges are CHECKed in SQL against typos, pending clinical sign-off (D-037).
model Vitals {
  id           String   @id @db.Uuid
  visitId      String   @map("visit_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  temperatureC Decimal? @map("temperature_c") @db.Decimal(4, 1)
  pulseBpm     Int?     @map("pulse_bpm")
  respRate     Int?     @map("resp_rate")
  bpSystolic   Int?     @map("bp_systolic")
  bpDiastolic  Int?     @map("bp_diastolic")
  spo2Pct      Int?     @map("spo2_pct")
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 1)
  heightCm     Decimal? @map("height_cm") @db.Decimal(4, 1)
  note         String?
  supersedesId String?  @unique @map("supersedes_id") @db.Uuid
  /// Why the superseded row was wrong. Set exactly when supersedes_id is.
  errorReason  String?  @map("error_reason")
  recordedById String   @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  visit        Visit   @relation(fields: [visitId], references: [id], onDelete: Restrict)
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  supersedes   Vitals? @relation("VitalsCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Vitals? @relation("VitalsCorrection")

  @@index([visitId, recordedAt])
  @@index([patientId, recordedAt])
  @@map("vitals")
}

enum AllergyKind {
  allergy
  no_known_allergies
}

enum AllergySeverity {
  mild
  moderate
  severe
  unknown
}

enum AllergyStatus {
  active
  resolved
  entered_in_error
}

/// Append-only (D-007). Each change is a new row superseding the previous one; the current
/// state is the rows nothing supersedes. "No known allergies" is an explicit row, never assumed.
model PatientAllergy {
  id           String           @id @db.Uuid
  patientId    String           @map("patient_id") @db.Uuid
  kind         AllergyKind
  /// Free text in M3; linked to an allergen group for prescribing checks in M5b (D-005).
  allergen     String?
  reaction     String?
  severity     AllergySeverity?
  status       AllergyStatus
  supersedesId String?          @unique @map("supersedes_id") @db.Uuid
  /// Required for entered_in_error; optional otherwise.
  reason       String?
  recordedById String           @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)

  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  supersedes   PatientAllergy? @relation("AllergyChange", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy PatientAllergy? @relation("AllergyChange")

  @@index([patientId, recordedAt])
  @@map("patient_allergy")
}

/// Append-only. Every save is a new version numbered per visit. A save based on a version that
/// is no longer the newest is still kept, flagged is_conflict, so nothing is overwritten.
model VisitNoteVersion {
  id                  String   @id @db.Uuid
  visitId             String   @map("visit_id") @db.Uuid
  versionNo           Int      @map("version_no")
  parentVersionId     String?  @map("parent_version_id") @db.Uuid
  presentingComplaint String?  @map("presenting_complaint")
  history             String?
  examination         String?
  diagnosisText       String?  @map("diagnosis_text")
  plan                String?
  isConflict          Boolean  @default(false) @map("is_conflict")
  authorId            String   @map("author_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  visit         Visit              @relation(fields: [visitId], references: [id], onDelete: Restrict)
  parentVersion VisitNoteVersion?  @relation("NoteParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  children      VisitNoteVersion[] @relation("NoteParent")

  @@unique([visitId, versionNo])
  @@map("visit_note_version")
}

/// A doctor's unsaved note (D-011): mutable, one per visit and user, deleted when a version is
/// saved. Not part of the clinical record.
model NoteDraft {
  visitId       String   @map("visit_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  content       Json
  baseVersionId String?  @map("base_version_id") @db.Uuid
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)

  @@id([visitId, userId])
  @@map("note_draft")
}
